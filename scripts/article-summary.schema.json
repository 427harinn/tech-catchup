{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary_short",
    "tech_points",
    "relevance",
    "next_action",
    "tags",
    "priority"
  ],
  "properties": {
    "summary_short": {
      "type": "string",
      "minLength": 1
    },
    "tech_points": {
      "type": "string",
      "minLength": 1
    },
    "relevance": {
      "type": "string",
      "minLength": 1
    },
    "next_action": {
      "type": "string",
      "minLength": 1
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "priority": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    }
  }
}
